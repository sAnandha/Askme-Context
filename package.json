{
  "name": "devctx-engine",
  "version": "0.1.0",
  "description": "Universal AI Persistent Context & Orchestration Engine for Development",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sAnandha/Askme-Context.git"
  },
  "homepage": "https://github.com/sAnandha/Askme-Context#readme",
  "bugs": {
    "url": "https://github.com/sAnandha/Askme-Context/issues"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode-extension",
    "packages/adapters",
    "packages/security",
    "packages/context-engine",
    "packages/embeddings",
    "packages/token-analyzer",
    "packages/git-intelligence",
    "packages/parsers",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run -ws build",
    "build:core": "npm run build -w packages/core",
    "test": "npm run test -ws",
    "lint": "eslint packages/*/src --ext .ts",
    "dev": "npm run dev -ws",
    "clean": "npm run clean -ws && rm -rf node_modules",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "context",
    "memory",
    "architecture",
    "development",
    "orchestration"
  ],
  "author": "DevContext Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.41"
  }
}
